{
  "name": "@kernelpilot/harness-bundle",
  "version": "0.1.0",
  "description": "Execution-feedback-driven CUDA kernel optimization for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/plugin.d.ts",
      "default": "./dist/harness/plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dsh": "dsh",
    "typecheck": "tsc --noEmit && pnpm typecheck:web",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/gpu/**",
    "test:gpu": "vitest run tests/gpu",
    "baseline": "tsx src/cli.ts baseline",
    "optimize": "pnpm build && tsx src/harness-launcher.ts",
    "optimize:reduction": "pnpm optimize examples/reduction/task.json",
    "optimize:elementwise": "pnpm optimize examples/elementwise/task.json",
    "web": "pnpm build && pnpm build:web && node dist/web/server.js",
    "web:dev": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  }
}
